<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Familles — SportConnect Pro</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/families.css">
</head>
<body>

<%
/* --------------------------------------------------------------
   Variable fournie par familyController.index : families
   (id, family_name, quotient_familial). Aucune autre donnée
   n'est disponible. quotient_familial peut être NULL en base
   (données anciennes) même si le formulaire l'exige désormais.
-------------------------------------------------------------- */

const familyList = families || [];

const hasQuotient = (f) => f.quotient_familial !== null && f.quotient_familial !== undefined;

const fmtQuotient = (q) => (q === null || q === undefined) ? 'Non renseigné' : Number(q).toFixed(2);

/* Statistiques calculées uniquement à partir de `families` */
const total       = familyList.length;
const withQuotient = familyList.filter(f => hasQuotient(f)).length;
const withoutQuotient = total - withQuotient;
const averageQuotient = withQuotient > 0
  ? familyList
      .filter(f => hasQuotient(f))
      .reduce((sum, f) => sum + Number(f.quotient_familial), 0) / withQuotient
  : null;
%>

<a class="skip-link" href="#contenu">Aller au contenu principal</a>

<!-- ============================ HEADER ============================ -->
<header class="topbar">
  <div class="topbar__inner">

    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 3v18M3 12h18" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="brand__name">SportConnect Pro</span>
    </a>

    <nav class="mainnav" aria-label="Navigation principale">
      <ul class="mainnav__list">
        <li><span class="navlink is-soon" aria-disabled="true">Dashboard<span class="soon">à venir</span></span></li>

        <li><a class="navlink" href="/activities">Activités</a></li>
        <li><a class="navlink" href="/facilities">Infrastructures</a></li>
        <li><a class="navlink" href="/associations">Associations</a></li>
        <li><a class="navlink" href="/members">Membres</a></li>
        <li><a class="navlink is-active" href="/families" aria-current="page">Familles</a></li>
        <li><a class="navlink" href="/registrations">Inscriptions</a></li>

        <!-- <li><span class="navlink is-soon" aria-disabled="true">Liste d’attente<span class="soon">à venir</span></span></li> -->
      </ul>
    </nav>

    <div class="topbar__user">
      <span class="user-chip">
        <span class="user-chip__avatar" aria-hidden="true">SG</span>
        <span class="user-chip__text">
          <span class="user-chip__name">Service des sports</span>
          <span class="user-chip__role">Gestionnaire</span>
        </span>
      </span>
    </div>

  </div>
</header>

<main id="contenu" class="page">
  <div class="wrap">

    <!-- ======================= EN-TÊTE DE PAGE ======================= -->
    <div class="pagehead">
      <div>
        <h1 class="pagehead__title">Familles</h1>
        <p class="pagehead__sub">Gérez les familles et leur quotient familial, utilisé pour le calcul des tarifs.</p>
      </div>
      <div class="pagehead__actions">
        <button type="button" class="btn btn--primary" data-modal-open="modal-create">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
          </svg>
          Nouvelle famille
        </button>
      </div>
    </div>

    <!-- ===================== STATISTIQUES RAPIDES ==================== -->
    <!-- Uniquement des chiffres calculés à partir de `families`. -->
    <section class="stats" aria-label="Chiffres clés">

      <article class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M8 8.5a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0 0 5.4ZM16 8.5a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0 0 5.4Z"/>
            <path d="M3 19c0-2.8 2.2-4.6 5-4.6s5 1.8 5 4.6M11 19c0-2.4 1.9-4 4.5-4s4.5 1.6 4.5 4" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="stat__value"><%= total %></span>
        <span class="stat__label">Familles enregistrées</span>
      </article>

      <article class="stat">
        <span class="stat__icon stat__icon--turf" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M4 18V9.8a1 1 0 0 1 .4-.8l7-5.4a1 1 0 0 1 1.2 0l7 5.4a1 1 0 0 1 .4.8V18" stroke-linejoin="round"/>
            <path d="M9 18v-5h6v5" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="stat__value"><%= averageQuotient !== null ? averageQuotient.toFixed(2) : '—' %></span>
        <span class="stat__label">Quotient familial moyen</span>
      </article>

      <article class="stat">
        <span class="stat__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="4" y="4.5" width="16" height="15" rx="2"/>
            <path d="M7.5 12.5l2.5 2.5 5.5-5.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="stat__value"><%= withQuotient %></span>
        <span class="stat__label">Quotient renseigné</span>
      </article>

      <article class="stat">
        <span class="stat__icon stat__icon--warning" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="12" cy="12" r="8.5"/>
            <path d="M9 9l6 6M15 9l-6 6" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="stat__value"><%= withoutQuotient %></span>
        <span class="stat__label">Quotient non renseigné</span>
      </article>

    </section>

    <!-- ===================== RECHERCHE ET FILTRES ==================== -->
    <!-- Recherche et filtre réalisés dans le navigateur : aucune requête au serveur. -->
    <section class="panel filters" aria-labelledby="filters-title">
      <h2 class="visually-hidden" id="filters-title">Rechercher une famille</h2>

      <div class="filters__grid">

        <div class="field field--search">
          <label for="filter-search">Rechercher une famille</label>
          <div class="input-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5" stroke-linecap="round"/>
            </svg>
            <input type="search" id="filter-search" autocomplete="off" placeholder="Nom de famille">
          </div>
        </div>

        <div class="field">
          <label for="filter-quotient">Quotient familial</label>
          <select id="filter-quotient">
            <option value="">Tous</option>
            <option value="present">Renseigné</option>
            <option value="missing">Non renseigné</option>
          </select>
        </div>

        <div class="filters__buttons">
          <button type="button" class="btn btn--ghost" id="filters-reset">Réinitialiser</button>
        </div>

      </div>
    </section>

    <!-- ======================== LISTE DES FAMILLES ==================== -->
    <section class="panel table-panel" aria-labelledby="list-title">

      <div class="table-panel__head">
        <h2 id="list-title" class="table-panel__title">Registre des familles</h2>
        <p class="table-panel__count" id="result-count" aria-live="polite">
          <%= total %> famille<%= total > 1 ? 's' : '' %>
        </p>
      </div>

      <% if (familyList.length === 0) { %>

        <div class="empty">
          <p class="empty__title">Aucune famille enregistrée.</p>
          <p class="empty__text">Ajoutez une première famille pour pouvoir l’associer à des membres.</p>
          <button type="button" class="btn btn--primary" data-modal-open="modal-create">Créer une famille</button>
        </div>

      <% } else { %>

        <div class="table-scroll">
          <table class="table" id="families-table">
            <caption class="visually-hidden">Familles avec leur quotient familial</caption>
            <thead>
              <tr>
                <th scope="col">ID</th>
                <th scope="col">Famille</th>
                <th scope="col">Quotient familial</th>
                <th scope="col" class="col-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
            <% familyList.forEach(family => {
                 const has = hasQuotient(family);
            %>
              <tr class="frow"
                  data-name="<%= family.family_name %>"
                  data-has_quotient="<%= has ? '1' : '0' %>">

                <td data-label="ID" class="num">#<%= family.id %></td>

                <td data-label="Famille"><span class="cell-title"><%= family.family_name %></span></td>

                <td data-label="Quotient familial" class="num">
                  <% if (has) { %>
                    <%= fmtQuotient(family.quotient_familial) %>
                  <% } else { %>
                    <span class="badge badge--missing">Non renseigné</span>
                  <% } %>
                </td>

                <td data-label="Actions" class="col-actions">
                  <div class="rowactions">

                    <button type="button" class="iconbtn"
                            aria-label="Voir la fiche de <%= family.family_name %>" title="Voir"
                            data-modal-open="modal-view"
                            data-id="<%= family.id %>"
                            data-name="<%= family.family_name %>"
                            data-quotient="<%= has ? fmtQuotient(family.quotient_familial) : '' %>">
                      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z"/>
                        <circle cx="12" cy="12" r="2.8"/>
                      </svg>
                      <span class="iconbtn__text">Voir</span>
                    </button>

                    <button type="button" class="iconbtn"
                            aria-label="Modifier <%= family.family_name %>" title="Modifier"
                            data-modal-open="modal-edit"
                            data-id="<%= family.id %>"
                            data-family_name="<%= family.family_name %>"
                            data-quotient_familial="<%= has ? family.quotient_familial : '' %>">
                      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path d="M4 20h4L19 9l-4-4L4 16v4Z" stroke-linejoin="round"/><path d="M14.5 5.5 18.5 9.5" stroke-linecap="round"/>
                      </svg>
                      <span class="iconbtn__text">Modifier</span>
                    </button>

                    <button type="button" class="iconbtn iconbtn--danger"
                            aria-label="Supprimer <%= family.family_name %>" title="Supprimer"
                            data-modal-open="modal-delete"
                            data-id="<%= family.id %>"
                            data-name="<%= family.family_name %>">
                      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path d="M4.5 6.5h15M9.5 6.5V4.8h5v1.7M6.5 6.5 7.4 20h9.2l.9-13.5" stroke-linejoin="round"/>
                        <path d="M10.2 10v6.4M13.8 10v6.4" stroke-linecap="round"/>
                      </svg>
                      <span class="iconbtn__text">Supprimer</span>
                    </button>

                  </div>
                </td>
              </tr>
            <% }); %>
            </tbody>
          </table>
        </div>

        <p class="empty empty--inline" id="no-match" hidden>
          <span class="empty__title">Aucune famille ne correspond à cette recherche.</span>
        </p>

      <% } %>
    </section>

  </div>
</main>


<!-- ===================== MODALE « NOUVELLE FAMILLE » =================== -->
<dialog class="modal modal--form" id="modal-create" aria-labelledby="modal-create-title">
  <form method="POST" action="/families" class="modal__form" novalidate>

    <header class="modal__head">
      <div>
        <h2 class="modal__title" id="modal-create-title">Nouvelle famille</h2>
        <p class="modal__sub">Renseignez le nom de famille et son quotient familial.</p>
      </div>
      <button type="button" class="modal__close" data-modal-close aria-label="Fermer la fenêtre">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="modal__body">
      <fieldset class="fset">
        <legend class="fset__legend">Informations familiales</legend>
        <div class="grid grid--1">
          <div class="field">
            <label for="create-family_name">Nom de famille</label>
            <input type="text" id="create-family_name" name="family_name" required maxlength="120" placeholder="Dupont">
          </div>
          <div class="field">
            <label for="create-quotient_familial">Quotient familial</label>
            <input type="number" id="create-quotient_familial" name="quotient_familial" min="0" step="0.01" required>
            <p class="field__hint">Champ obligatoire : une valeur numérique est requise par le serveur.</p>
          </div>
        </div>
      </fieldset>
    </div>

    <footer class="modal__foot">
      <button type="button" class="btn btn--ghost" data-modal-close>Annuler</button>
      <button type="submit" class="btn btn--primary">Créer la famille</button>
    </footer>

  </form>
</dialog>


<!-- ======================= MODALE MODIFICATION ========================= -->
<dialog class="modal modal--form" id="modal-edit" aria-labelledby="modal-edit-title">
  <form method="POST" action="/families/update" class="modal__form" novalidate>
    <input type="hidden" name="id" id="edit-id">

    <header class="modal__head">
      <div>
        <h2 class="modal__title" id="modal-edit-title">Modifier la famille</h2>
        <p class="modal__sub" id="modal-edit-sub">Mettez à jour les informations de la famille.</p>
      </div>
      <button type="button" class="modal__close" data-modal-close aria-label="Fermer la fenêtre">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="modal__body">
      <fieldset class="fset">
        <legend class="fset__legend">Informations familiales</legend>
        <div class="grid grid--1">
          <div class="field">
            <label for="edit-family_name">Nom de famille</label>
            <input type="text" id="edit-family_name" name="family_name" required maxlength="120">
          </div>
          <div class="field">
            <label for="edit-quotient_familial">Quotient familial</label>
            <input type="number" id="edit-quotient_familial" name="quotient_familial" min="0" step="0.01" required>
            <p class="field__hint">Champ obligatoire : une valeur numérique est requise par le serveur.</p>
          </div>
        </div>
      </fieldset>
    </div>

    <footer class="modal__foot">
      <button type="button" class="btn btn--ghost" data-modal-close>Annuler</button>
      <button type="submit" class="btn btn--primary">Enregistrer les modifications</button>
    </footer>

  </form>
</dialog>


<!-- ===================== MODALE DÉTAILS (lecture) ===================== -->
<dialog class="modal modal--view" id="modal-view" aria-labelledby="modal-view-title">
  <header class="modal__head">
    <div>
      <h2 class="modal__title" id="modal-view-title">Fiche famille</h2>
    </div>
    <button type="button" class="modal__close" data-modal-close aria-label="Fermer la fenêtre">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/>
      </svg>
    </button>
  </header>

  <div class="modal__body">
    <dl class="detail">
      <div><dt>ID</dt><dd id="view-id">—</dd></div>
      <div><dt>Nom de famille</dt><dd id="view-name">—</dd></div>
      <div><dt>Quotient familial</dt><dd id="view-quotient">—</dd></div>
    </dl>
  </div>

  <footer class="modal__foot">
    <button type="button" class="btn btn--ghost" data-modal-close>Fermer</button>
  </footer>
</dialog>


<!-- =================== MODALE CONFIRMATION SUPPRESSION ================= -->
<dialog class="modal modal--confirm" id="modal-delete" aria-labelledby="modal-delete-title">
  <form method="POST" action="/families/delete" class="modal__form">
    <input type="hidden" name="id" id="delete-id">

    <div class="confirm">
      <span class="confirm__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 8.5v5" stroke-linecap="round"/><circle cx="12" cy="16.8" r="1.1" fill="currentColor" stroke="none"/>
          <path d="M10.6 3.9 2.9 17.4A1.6 1.6 0 0 0 4.3 19.8h15.4a1.6 1.6 0 0 0 1.4-2.4L13.4 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke-linejoin="round"/>
        </svg>
      </span>
      <div>
        <h2 class="confirm__title" id="modal-delete-title">Supprimer cette famille&nbsp;?</h2>
        <p class="confirm__text">
          <span id="delete-name" class="confirm__target">Cette famille</span> sera retirée du registre. Cette action est irréversible.
        </p>
      </div>
    </div>

    <footer class="modal__foot">
      <button type="button" class="btn btn--ghost" data-modal-close>Annuler</button>
      <button type="submit" class="btn btn--danger">Supprimer</button>
    </footer>

  </form>
</dialog>

<script src="/js/families.js" defer></script>
</body>
</html>
